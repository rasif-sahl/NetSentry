# Local environment configuration must never be committed.
.env
.env.*.local

# Local database data, if a bind mount is ever used instead of the named Docker volume.
postgres-data/

# Generated locally or in CI; uploaded as a workflow artifact when needed.
artifacts/

# Local third-party private keys must remain outside version control.
/backend/secrets/

.DS_Store

# Platform dependencies and generated output.
node_modules/
dist/
coverage/
*.tsbuildinfo

# Native local configuration, caches, builds and signing materials.
.gradle/
.kotlin/
**/build/
local.properties
DerivedData/
xcuserdata/
*.xcuserstate
*.ipa
*.apk
*.aab
*.dSYM/
*.jks
*.keystore
*.p12
*.mobileprovision

# Go outputs and local agent state.
/agent/bin/
/agent/.local/
