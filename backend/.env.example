NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://netsentry:change-me@localhost:5432/netsentry
DATABASE_SSL=false
# Optional PEM CA certificate when DATABASE_SSL=true; certificate verification stays enabled.
# DATABASE_SSL_CA=
# Migrations are explicit; startup never runs them automatically.
DB_SYNCHRONIZE=false

# Generate independent secrets with: openssl rand -base64 48
JWT_ACCESS_TOKEN_SECRET=replace-with-a-unique-secret-at-least-32-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-another-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Generate independently with: openssl rand -base64 32
ACCOUNT_MAIL_ENCRYPTION_KEY=replace-with-an-independent-base64-32-byte-key
# The API queues encrypted mail. Sending requires explicit SMTP configuration.
MAIL_ENABLED=false
PUBLIC_APP_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional until router setup is used. Generate separately: openssl rand -base64 32
# Store outside the database; changing it requires configuring router credentials again.
ROUTER_CREDENTIAL_ENCRYPTION_KEY=
