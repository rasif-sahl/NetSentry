NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://netsentry:change-me@localhost:5432/netsentry
DATABASE_SSL=false
# Development convenience only. Use migrations and false in production.
DB_SYNCHRONIZE=true

# Generate independent secrets with: openssl rand -base64 48
JWT_ACCESS_TOKEN_SECRET=replace-with-a-unique-secret-at-least-32-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-another-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30
