{
  "name": "netsentry",
  "version": "0.0.0",
  "private": true,
  "description": "NetSentry platform development commands; applications keep independent dependencies.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:scaffolds": "node scripts/check-scaffolds.mjs",
    "build:backend": "npm --prefix backend run build",
    "test:backend": "npm --prefix backend test -- --runInBand",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:dashboard": "npm --prefix dashboard run dev -- --port 3001",
    "build:desktop": "npm --prefix desktop run build",
    "check:desktop": "npm --prefix desktop run typecheck",
    "test:agent": "cd agent && GOTOOLCHAIN=local go test ./...",
    "check:contracts": "npm --prefix contracts run check",
    "test:contracts": "npm --prefix contracts test",
    "check": "npm run check:scaffolds && npm run check:contracts && npm run test:contracts && npm run check:android && npm run check:ios && npm run build:backend && npm run test:backend && npm run build:desktop && npm run lint:dashboard && npm run build:dashboard",
    "test:database": "npm --prefix backend run test:database",
    "test:api": "npm --prefix backend run test:api",
    "build:dashboard": "npm --prefix dashboard run build",
    "lint:dashboard": "npm --prefix dashboard run lint",
    "test:dashboard": "npm --prefix dashboard run test:e2e",
    "test:desktop-agent": "npm --prefix desktop run test:agent",
    "check:android": "node android/scripts/check-contracts.mjs && node android/scripts/check-applications.mjs",
    "test:android-core": "bash android/scripts/check-jvm.sh",
    "check:ios": "node ios/scripts/check-source.mjs",
    "test:ios-core": "bash ios/scripts/check-core.sh",
    "test:ios-live": "node ios/scripts/check-live.mjs"
  }
}
