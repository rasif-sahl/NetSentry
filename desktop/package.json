{
  "name": "@netsentry/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
