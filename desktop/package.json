{
  "name": "@netsentry/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "test:agent": "node scripts/check-agent.mjs",
    "test:developer": "node scripts/check-developer.mjs",
    "package:preview": "npm run build && node scripts/package-desktop.mjs preview",
    "package:release": "npm run build && node scripts/package-desktop.mjs release",
    "test:updates": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "description": "NetSentry desktop monitoring and developer tools",
  "author": "NetSentry"
}
