{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsentry.example/schemas/local-ipc-response.v5.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "ok", "code", "data"],
      "properties": {
        "schemaVersion": {
          "const": 5
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "ok": {
          "const": true
        },
        "code": {
          "const": "OK"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sharing", "networkId", "supported"],
          "properties": {
            "sharing": {
              "type": "boolean"
            },
            "supported": {
              "type": "boolean"
            },
            "networkId": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "ok", "code", "data"],
      "properties": {
        "schemaVersion": {
          "const": 5
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "ok": {
          "const": false
        },
        "code": {
          "enum": ["INVALID_REQUEST", "NETWORK_SETTINGS_FAILED"]
        },
        "data": {
          "type": "null"
        }
      }
    }
  ]
}
