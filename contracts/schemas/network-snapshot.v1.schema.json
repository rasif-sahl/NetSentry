{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsentry.example/schemas/network-snapshot.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "networkId",
    "generation",
    "revision",
    "observedAt",
    "interfaces",
    "neighbors",
    "router"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "networkId": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cidr", "gateway"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "cidr": {
            "type": "string"
          },
          "gateway": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 16
    },
    "neighbors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "mac", "evidence"],
        "properties": {
          "address": {
            "type": "string"
          },
          "mac": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2}:){5}[0-9a-f]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string",
            "enum": ["reachable", "cached", "unknown"]
          }
        }
      },
      "maxItems": 128
    },
    "router": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "routerId",
            "revision",
            "status",
            "wanUp",
            "uptimeSeconds",
            "rxBytes",
            "txBytes",
            "model",
            "firmware",
            "testRequestId"
          ],
          "properties": {
            "routerId": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "auth_failed",
                "tls_failed",
                "unavailable",
                "unsupported"
              ]
            },
            "wanUp": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "uptimeSeconds": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,11})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rxBytes": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "txBytes": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "firmware": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "testRequestId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
