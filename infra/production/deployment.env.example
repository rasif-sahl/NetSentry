# Copy outside the repository; chmod 0600. Never place credentials here.
COMPOSE_PROJECT_NAME=netsentry-production
BACKEND_IMAGE=registry.example.invalid/netsentry/backend@sha256:REPLACE_WITH_REVIEWED_DIGEST
DASHBOARD_IMAGE=registry.example.invalid/netsentry/dashboard@sha256:REPLACE_WITH_REVIEWED_DIGEST
INGRESS_IMAGE=nginx@sha256:REPLACE_WITH_REVIEWED_DIGEST
SERVER_ENV_FILE=/etc/netsentry/backend.env
DASHBOARD_ENV_FILE=/etc/netsentry/dashboard.env
SERVER_SECRET_DIR=/etc/netsentry/secrets
TLS_CERT_DIR=/etc/netsentry/tls
INGRESS_CONFIG_FILE=/etc/netsentry/nginx.conf
PUBLIC_HOST=netsentry.example.invalid
HTTPS_BIND_ADDRESS=127.0.0.1
