# Private host-side EnvironmentFile, mode 0600. Paths are on the host, not /run/secrets.
NODE_ENV=production
DATABASE_SSL=true
DATABASE_URL_FILE=/etc/netsentry/backup-secrets/database-url
DATABASE_SSL_CA_FILE=/etc/netsentry/backup-secrets/database-ca
PGSSLROOTCERT=/etc/netsentry/backup-secrets/database-ca
BACKUP_KEY_FILE=/etc/netsentry/backup-secrets/backup-key.bin
BACKUP_DIR=/var/lib/netsentry/backups
BACKUP_KEEP_COUNT=7
BACKUP_MAX_AGE_HOURS=36
PG_BIN_DIR=/usr/lib/postgresql/17/bin
